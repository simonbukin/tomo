{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "browser",
  "description": "lets the page inside a browser pane report its annotations",
  "local": true,
  "remote": {
    "urls": [
      "http://*:*",
      "https://*:*"
    ]
  },
  "webviews": [
    "browser-*"
  ],
  "permissions": [
    "allow-browser-annotations"
  ]
}
